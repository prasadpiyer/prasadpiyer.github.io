{% from "macros.j2" import news_item, avatar, person %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ site.name }} · {{ site.pi }} · ASRC, CUNY</title>
<meta name="description" content="{{ site.description }}">
<meta property="og:title" content="{{ site.name }}">
<meta property="og:description" content="{{ site.description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}">
<meta property="og:image" content="{{ site.url }}{{ site.share_image }}">
<meta property="og:image:alt" content="{{ site.hero_alt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ site.name }}">
<meta name="twitter:description" content="{{ site.description }}">
<meta name="twitter:image" content="{{ site.url }}{{ site.share_image }}">
<link rel="canonical" href="{{ site.url }}">
<meta name="theme-color" content="#2b2350">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='0' y2='1'%3E%3Cstop offset='0' stop-color='%23f2b257'/%3E%3Cstop offset='1' stop-color='%23e9793a'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='32' height='32' rx='7' fill='%232b2350'/%3E%3Ccircle cx='16' cy='16' r='8' fill='url(%23g)'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Source+Sans+3:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="assets/style.css?v={{ build_id }}">
</head>
<body>

<nav class="top gut" aria-label="Main">
  <div class="col">
    <a class="brand" href="#home"><span class="sun" aria-hidden="true"></span>{{ site.name }}</a>
    <ul>
      <li><a href="#home">Home</a></li>
      <li><a href="#research">Research</a></li>
      <li><a href="#publications">Publications</a></li>
      <li><a href="#people">People</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </div>
</nav>

<header class="hero gut{% if not site.hero_image %} solo{% endif %}" id="home">
  <div class="col">
    <div>
      <span class="aff">{{ site.affiliation }}</span>
      <h1>{{ site.headline }}</h1>
      <p class="lead">{{ site.lead }}</p>
      <div class="btns"><a class="btn gold" href="#research">Our research</a><a class="btn ghost" href="#people">Join the lab</a></div>
    </div>
    {% if site.hero_image %}
    <figure class="photo-wrap">
      <picture>
        {% if site.hero_image_wide %}<source media="(max-width: 680px)" srcset="{{ site.hero_image_wide }}">{% endif %}
        <img class="photo" src="{{ site.hero_image }}" alt="{{ site.hero_alt }}" fetchpriority="high"{% if site.hero_aspect %} style="--hero-aspect:{{ site.hero_aspect }}"{% endif %}>
      </picture>
      {% if site.hero_credit %}<figcaption>{{ site.hero_credit }}</figcaption>{% endif %}
    </figure>
    {% endif %}
  </div>
</header>

<main>
<section class="s gut" aria-labelledby="news-h">
  <div class="col">
    <span class="kicker">Home</span>
    <h2 id="news-h">Latest news and activities</h2>
    <div class="news">
      {% for n in news[:site.news_on_home] %}{{ news_item(n) }}{% endfor %}
    </div>
    {% if news|length > site.news_on_home %}
    <details class="more">
      <summary>Earlier news ({{ news|length - site.news_on_home }})</summary>
      <div class="news">{% for n in news[site.news_on_home:] %}{{ news_item(n) }}{% endfor %}</div>
    </details>
    {% endif %}
  </div>
</section>

<section class="s gut" id="research" aria-labelledby="res-h">
  <div class="col">
    <span class="kicker">Research</span>
    <h2 id="res-h">{{ research|length }} research programs</h2>
    <p class="intro">Each program combines nanofabrication, ultrafast and quantum spectroscopy, and experiments run by machine learning.</p>
    {% for r in research %}
    <article class="proj{% if r.wide %} wide{% endif %}">
      {% if r.image %}<img class="{{ 'figure' if r.wide else 'thumb' }}" src="{{ r.image }}" alt="{{ r.alt }}" loading="lazy">{% else %}<div class="thumb th{{ loop.index }}" aria-hidden="true"></div>{% endif %}
      <div><h3>{{ r.title }}</h3><p>{{ r.text }}</p>
        {% if r.key_papers %}
        <div class="keypapers"><span class="kp-label">Key papers</span>
          <ul>{% for k in r.key_papers %}<li>{% if k.url %}<a href="{{ k.url }}">{{ k.title }}</a>{% else %}{{ k.title }}{% endif %} <span class="kp-ven">{{ k.venue }}{% if k.venue and k.year %}, {% endif %}{{ k.year }}</span></li>{% endfor %}</ul>
        </div>
        {% endif %}
      </div>
    </article>
    {% endfor %}
  </div>
</section>

<section class="s gut" id="publications" aria-labelledby="pub-h">
  <div class="col">
    <span class="kicker">Publications</span>
    <h2 id="pub-h">Publications</h2>
    <p class="intro">Papers, conference contributions, patents and talks, from my <a href="{{ scholar_url }}">Google Scholar</a> profile. Choose a category to filter the list.</p>
    <div id="pubs" data-src="data/publications.json" data-extra="data/publications_extra.json"
         data-scholar="{{ scholar_url }}" data-selected='{{ site.selected_publications | tojson }}'>
      <p class="pub-count">Loading publications…</p>
      <noscript><p class="pub-count">The publication list needs JavaScript. See the full list on <a href="{{ scholar_url }}">Google Scholar</a>.</p></noscript>
    </div>

    <div class="pubfoot">
      <button type="button" id="bib-dl" class="linkbtn" hidden>Download all as BibTeX (.bib) ↓</button>
      {% for l in site.links if l.label in ("Google Scholar", "ORCID") %}<a href="{{ l.url }}">{{ l.label }} →</a>{% endfor %}
    </div>
  </div>
</section>

<section class="s gut" id="people" aria-labelledby="ppl-h">
  <div class="col">
    <span class="kicker">People</span>
    <h2 id="ppl-h">The lab</h2>
    <div class="pi">
      {{ avatar(people.pi, "portrait") }}
      <div>
        <h3>{{ people.pi.name }}</h3>
        <p class="role">{{ people.pi.role }}</p>
        <p class="bio">{{ people.pi.bio }}</p>
        {% if people.pi.cv_url %}<p class="cv"><a href="{{ people.pi.cv_url }}">Curriculum vitae →</a></p>{% endif %}
      </div>
    </div>

    {% if people.current %}
    <h3 class="sub">Current members</h3>
    <div class="grid">{% for p in people.current %}{{ person(p) }}{% endfor %}</div>
    {% endif %}

    <h3 class="sub" id="openings">Open positions</h3>
    <div class="openings">
      {% for o in people.openings %}<div class="open{% if o.skills %} wide{% endif %}"><b>{{ o.title }}</b><span>{{ o.text }}</span>{% if o.skills %}<ul class="skills">{% for sk in o.skills %}<li>{{ sk }}</li>{% endfor %}</ul>{% endif %}{% if o.note %}<span class="plus">{{ o.note }}</span>{% endif %}{% if o.start %}<span class="start"><b>Start date:</b> {{ o.start }}</span>{% endif %}{% for l in o.links %}<a class="open-link" href="{{ l.url }}">{{ l.label }} →</a>{% endfor %}</div>{% endfor %}
    </div>
    <p class="apply">To apply, email <span class="sel">{{ site.contact.email }}</span> with your CV and the position you are interested in.</p>

    {% if people.former %}
    <h3 class="sub">Former postdocs</h3>
    <div class="grid">{% for p in people.former %}{{ person(p) }}{% endfor %}</div>
    {% endif %}

    {% if people.collaborators %}
    <h3 class="sub">Collaborators</h3>
    <div class="grid">{% for p in people.collaborators %}{{ person(p) }}{% endfor %}</div>
    {% endif %}
  </div>
</section>

<section class="s gut" id="contact" aria-labelledby="con-h">
  <div class="col">
    <span class="kicker">Contact</span>
    <h2 id="con-h">Get in touch</h2>
    <div class="contact">
      <div class="card"><span class="lab">Visit</span>
        <p>{% for line in site.contact.address %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
        <a href="{{ site.contact.map_url }}">Open in Google Maps →</a></div>
      <div class="card"><span class="lab">Email</span>
        <p><a class="sel" href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></p>
        <span class="lab gap">Elsewhere</span>
        <p>{% for l in site.links %}<a href="{{ l.url }}">{{ l.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p></div>
    </div>
  </div>
</section>
{% if site.funders %}
<section class="s gut funders" aria-labelledby="fund-h">
  <div class="col">
    <span class="kicker">Support</span>
    <h2 id="fund-h">Funders and sponsors</h2>
    <ul class="funder-list">
      {% for f in site.funders %}<li>{% if f.url %}<a href="{{ f.url }}">{{ f.name }}</a>{% else %}{{ f.name }}{% endif %}{% if f.note %}<span>{{ f.note }}</span>{% endif %}</li>{% endfor %}
    </ul>
  </div>
</section>
{% endif %}
</main>

<footer class="gut">
  <div class="col">
    <span>© {{ year }} {{ site.name }} · led by {{ site.pi }} · {{ site.affiliation }}</span>
    <span>Updated {{ updated }}</span>
  </div>
</footer>
<script src="assets/publications.js?v={{ build_id }}" defer></script>
{% if site.goatcounter %}
<script src="assets/track.js?v={{ build_id }}" defer></script>
<script data-goatcounter="{{ site.goatcounter }}" async src="https://gc.zgo.at/count.js"></script>
{% endif %}
</body>
</html>
