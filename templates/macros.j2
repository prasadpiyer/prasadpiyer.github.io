{%- macro news_item(n) -%}
<div class="item{% if n.pinned %} pinned{% endif %}"><span class="date">{{ n.date | month }}</span><p><span class="tag t-{{ n.tag | lower }}">{{ n.tag }}</span>{% if n.url %}<a href="{{ n.url }}">{{ n.text }}</a>{% else %}{{ n.text }}{% endif %}</p></div>
{%- endmacro -%}
{%- macro avatar(p, cls) -%}
{% if p.photo %}<img class="{{ cls }}" src="{{ p.photo }}" alt="{{ p.name }}" loading="lazy">{% else %}<div class="{{ cls }} initials" aria-hidden="true">{{ p.name | initials }}</div>{% endif %}
{%- endmacro -%}
{%- macro person(p) -%}
<div class="person">{{ avatar(p, "ph") }}<b>{% if p.url %}<a href="{{ p.url }}">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}</b>{% if p.role %}<span>{{ p.role }}</span>{% endif %}{% if p.note %}<span>{{ p.note }}</span>{% endif %}</div>
{%- endmacro -%}
