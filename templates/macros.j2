{%- macro news_item(n) -%}
<div class="item"><span class="date">{{ n.date | month }}</span><p><span class="tag t-{{ n.tag | lower }}">{{ n.tag }}</span>{% if n.url %}<a href="{{ n.url }}">{{ n.text }}</a>{% else %}{{ n.text }}{% endif %}</p></div>
{%- endmacro -%}
{%- macro pub(p, show_authors) -%}
<div class="pub"><b>{% if p.url %}<a href="{{ p.url }}">{{ p.title }}</a>{% else %}{{ p.title }}{% endif %}</b>
{%- if show_authors and p.authors %}<span class="au">{{ p.authors | bold_pi }}</span>{% endif -%}
<span>{% if p.venue %}<i>{{ p.venue }}</i>{% endif %}{% if p.kind == "preprint" %} · preprint{% endif %}{% if p.invited %} · invited{% endif %}</span></div>
{%- endmacro -%}
{%- macro avatar(p, cls) -%}
{% if p.photo %}<img class="{{ cls }}" src="{{ p.photo }}" alt="{{ p.name }}" loading="lazy">{% else %}<div class="{{ cls }} initials" aria-hidden="true">{{ p.name | initials }}</div>{% endif %}
{%- endmacro -%}
{%- macro person(p) -%}
<div class="person">{{ avatar(p, "ph") }}<b>{{ p.name }}</b>{% if p.role %}<span>{{ p.role }}</span>{% endif %}{% if p.note %}<span>{{ p.note }}</span>{% endif %}</div>
{%- endmacro -%}
